# Copy to .env beside pom.xml and fill in your local values.
# Git ignores .env; keep only example values in this file.
# Single or double quotes preserve spaces at the start or end of a value.
# Values are literal: no variable expansion or inline comments.
API_KEY=your-rest-countries-api-key

# Accounts and ranking are optional; leave disabled for local guest play.
ACCOUNTS_ENABLED=false

# Enable after applying database/003_shared_rounds.sql and 004_shared_oauth_sessions.sql.
# Required to share rounds and OAuth login across instances, such as on Vercel.
SHARED_STATE_ENABLED=false
# APP_URL=https://your-service.onrender.com
# JDBC_DATABASE_URL=jdbc:postgresql://your-endpoint.neon.tech/neondb?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
# DATABASE_USER=your-database-role
# DATABASE_PASSWORD=your-database-password
# GOOGLE_CLIENT_ID=your-google-web-client-id
# GOOGLE_CLIENT_SECRET=your-google-web-client-secret
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Spring Security callbacks: use the APP_URL/PORT address for your environment.
# http://localhost:8080/login/oauth2/code/google
# http://localhost:8080/login/oauth2/code/github
# Apply database/001_accounts.sql, then 002_oauth_profile.sql before enabling accounts.
